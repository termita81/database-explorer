{
  "name": "db-explorer",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm build && node packages/server/dist/cli.js",
    "start": "node packages/server/dist/cli.js",
    "test": "pnpm build && vitest run",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.test.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:adapters": "pnpm build && vitest run packages/adapter-sqlite/test",
    "test:e2e": "pnpm build && playwright test"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "prettier": "^3.6.2",
    "@types/node": "^22.18.0",
    "@playwright/test": "^1.56.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "vite": "^6.4.1",
    "jsdom": "^26.1.0",
    "vue": "^3.5.22"
  }
}
